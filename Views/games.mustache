<style>
    .deleteBTN{
        margin-top: 15px;
        color: white;
        background-color: red;
    }
    .createBTN{
        margin-top: 15px;
        color: white;
        background-color: orange;
        height: 50px;
        width: 75px
       font-size: 25px;
    }
</style>

{{>header}}

{{>navigation}}

<div class="row">
    <div class="card">
        <h2>GAME LIST</h2>
        {{#displaylogout}}
            <form action="/games/create" method="GET">
                <input type="submit" class=createBTN value="create new game">
            </form>
        {{/displaylogout}}
        {{#games}}
            <h3>Name: {{Name}}</h3>
            <label>Category: {{Category}}</label><br>
            <label>Amount Available: {{Amount_Available}}</label><br>
            <label>Price: ${{Price}}</label><br>
            {{#displaylogout}}
                <a  href="/games/view/{{Name}}">Update</a>
                <form action="/games/delete/{{Name}}" method="POST">
                    <input type="submit" class=deleteBTN value="Delete {{Name}}">
                </form>
            {{/displaylogout}}
            <p>-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_</p>
            {{/games}}
    </div>
</div